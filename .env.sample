# App
APP_NAME=Hector Investment API
ENVIRONMENT=development
DEBUG=True
VERSION=1.0.0

# Database
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=kanec_db

# Security
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PRIVATE_KEY_ENCRYPTION_KEY=generate-with-python-cryptography-fernet

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://localhost:5173

# Email
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Hector Investments
VERIFICATION_BASE_URL=http://localhost:8000/verify

# Redis / Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---------- Hedera (custodial HBAR) ----------
# Portal: https://portal.hedera.com  → create testnet account, copy ID + private key
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=your-hedera-ecdsa-private-key

# ---------- Multi-chain (connect + live balances) ----------
# Comma-separated: hedera,ethereum,bitcoin,solana,bnb,polygon,usdt,usdc
ENABLED_CHAINS=hedera,ethereum,bitcoin,solana,bnb,polygon,usdt,usdc

# Ethereum — free Sepolia RPC from Alchemy or Infura
# Alchemy: https://www.alchemy.com → app → Sepolia → HTTPS URL
# Infura:  https://infura.io → Ethereum Sepolia endpoint
ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
ETHEREUM_NETWORK=sepolia

# BNB Smart Chain testnet (public, no key)
BNB_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BNB_NETWORK=testnet

# Polygon Amoy testnet (public)
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_NETWORK=amoy

# Bitcoin testnet (Blockstream public API, no key)
BITCOIN_API_URL=https://blockstream.info/testnet/api
BITCOIN_NETWORK=testnet
# Mainnet would be: https://blockstream.info/api

# Solana devnet (public)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# Stablecoins (optional) — contract on the same network as STABLECOIN_RPC_SOURCE
USDT_CONTRACT_ADDRESS=
USDC_CONTRACT_ADDRESS=
STABLECOIN_RPC_SOURCE=ethereum

REQUIRE_WALLET_SIGNATURE=false

# EOA that users approve as spender. Key must match product.contract_address.
# Needs a little native ETH/BNB for gas. Never commit a real key.
PLATFORM_EVM_WALLET=
PLATFORM_EVM_PRIVATE_KEY=
# Deployed contracts/InvestmentPlatform.sol (users approve this address)
INVESTMENT_PLATFORM_ADDRESS=

# Security
ALLOW_WALLET_EXPORT=true
ENABLE_DOCS=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
ACCESS_TOKEN_EXPIRE_HOURS=12
# Set ENVIRONMENT=production to hide /docs and scrub error details

# Rate limiting (false = off for local dev; true in production)
RATE_LIMIT_ENABLED=false

# false = send OTP in API process (no Celery worker needed)
EMAIL_USE_CELERY=false
